# Copy to .env; supply a real local or hosted PostgreSQL URL.
DATABASE_URL="postgresql://mindquest:mindquest@localhost:5432/mindquest?schema=public"
# Optional direct connection for Prisma migrations. On Neon, copy the URL with
# connection pooling disabled; keep the pooled URL above for app requests.
DATABASE_URL_UNPOOLED=""
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
