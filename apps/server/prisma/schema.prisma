generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  quests        Quest[]
  progress      Progress?
  gameAttempts  GameAttempt[]
  gameRewards   GameReward[]
  quizzes       Quiz[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model Quest {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  difficulty  Difficulty @default(EASY)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model GameAttempt {
  id            String    @id @default(cuid())
  ownerKey      String
  quizId        String?
  quiz          Quiz?     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  participantName String?
  participantAvatar String?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode          String    @default("knowledge")
  config        Json
  state         Json
  score         Int       @default(0)
  correctCount  Int       @default(0)
  bestStreak    Int       @default(0)
  xpAwarded     Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  abandonedAt   DateTime?
  reward        GameReward?
  @@index([ownerKey, startedAt])
  @@index([quizId, startedAt])
}

model GameReward {
  id        String      @id @default(cuid())
  attemptId String      @unique
  attempt   GameAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimKey  String      @unique
  xp        Int
  createdAt DateTime    @default(now())
  @@index([userId, createdAt])
}

model Quiz {
  id        String        @id @default(cuid())
  creatorId String
  creator   User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title     String
  builtIn   Boolean       @default(false)
  seedKey   String?       @unique
  topic     String        @default("Community")
  icon      String        @default("✨")
  description String      @default("")
  difficultyLabel String  @default("Explorer")
  progress  PlayerQuizProgress[]
  code      String        @unique
  questions Json
  timed     Boolean       @default(false)
  published Boolean       @default(true)
  createdAt DateTime      @default(now())
  attempts  GameAttempt[]
  @@index([creatorId, createdAt])
}

model PlayerProfile {
  id              String   @id @default(cuid())
  ownerKey        String   @unique
  name            String   @default("Explorer")
  avatar          String   @default("owl")
  totalXp         Int      @default(0)
  coins           Int      @default(0)
  unlockedAvatars String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  progress        PlayerQuizProgress[]
}

model PlayerQuizProgress {
  id          String   @id @default(cuid())
  ownerKey    String
  player      PlayerProfile @relation(fields: [ownerKey], references: [ownerKey], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  bestCorrect Int      @default(0)
  xpEarned    Int      @default(0)
  coinsEarned Int      @default(0)
  mastered    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  @@unique([ownerKey, quizId])
}
