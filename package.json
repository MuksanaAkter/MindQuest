{
  "name": "mindquest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mindquest/web dev",
    "build": "prisma generate && pnpm --filter @mindquest/web build",
    "start": "pnpm --filter @mindquest/web start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web && tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed": "node scripts/seed-quizzes.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8"
  }
}
